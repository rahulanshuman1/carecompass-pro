# Web (Vercel): leave empty. The app calls /api/v1 and vercel.json proxies /api/* to Render,
# so cookies are first-party and no CORS is needed.
VITE_API_URL=

# Android build only: the native app has no Vercel proxy, so point it straight at Render.
# (Set CLIENT_ORIGINS on Render to include https://localhost and COOKIE_SAMESITE=none.)
# VITE_API_URL=https://YOUR-RENDER-SERVICE.onrender.com/api/v1

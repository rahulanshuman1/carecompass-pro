# ---- Core ----
NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/carecompass?retryWrites=true&w=majority
APP_TIMEZONE=Asia/Kolkata

# ---- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ----
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too
PHI_ENCRYPTION_KEY=change-me-phi-key-change-me-phi-key-1234

# ---- CORS / cookies ----
# Comma-separated list of allowed browser origins (Vercel domain, custom domain, Capacitor app)
CLIENT_ORIGINS=http://localhost:5173,https://localhost
# lax works when the browser talks to the API through the Vercel /api rewrite (same-site).
# Use none if the web app or Android app calls the Render URL directly (requires HTTPS).
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# ---- Razorpay (Dashboard → Account & Settings → API Keys / Webhooks) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# ---- First lead doctor (used by npm run seed:admin) ----
ADMIN_NAME=Dr. Admin
ADMIN_EMAIL=admin@yourhospital.com
ADMIN_PASSWORD=ChangeThisPassword!123

# Set to "order" to use one-time Razorpay Orders (works without the Subscriptions product; first month only). Leave unset for monthly Subscriptions.
PAYMENT_MODE=
